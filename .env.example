# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The runnable dev default is SQLite (no external service required).
# To use PostgreSQL: change `provider` in prisma/schema.prisma to "postgresql"
# and set a postgres connection string here, e.g.
#   DATABASE_URL="postgresql://user:pass@localhost:5432/reels?schema=public"
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Video source (YouTube retrieval)
# ---------------------------------------------------------------------------
# ytdlp = download the real YouTube video (recommended). Requires the yt-dlp
#         binary — run `npm run setup:ytdlp` once to fetch it into ./bin.
# mock  = generate a synthetic local test video (offline; produces a colour-bar
#         placeholder, useful only when there is no network / no yt-dlp).
VIDEO_SOURCE_PROVIDER="ytdlp"
# Path to the yt-dlp executable.
YTDLP_PATH="./bin/yt-dlp"
# To access videos that require a signed-in account (e.g. age-restricted ones
# you can watch while logged in), authenticate as your own account with cookies.
# Option A — read cookies straight from a local browser profile:
#   YTDLP_COOKIES_FROM_BROWSER="chrome"   # or firefox, edge, brave, safari
# Option B — point to a Netscape-format cookies.txt you exported while signed in:
#   YTDLP_COOKIES_FILE="/absolute/path/to/cookies.txt"
YTDLP_COOKIES_FROM_BROWSER=""
YTDLP_COOKIES_FILE=""

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
# mock   = deterministic synthetic transcript (offline, no key required)
# openai = OpenAI Whisper API (requires TRANSCRIPTION_API_KEY)
TRANSCRIPTION_PROVIDER="mock"
TRANSCRIPTION_API_KEY=""
# Base URL + model for the OpenAI-compatible transcription endpoint
TRANSCRIPTION_BASE_URL="https://api.openai.com/v1"
TRANSCRIPTION_MODEL="whisper-1"

# ---------------------------------------------------------------------------
# AI clip detection
# ---------------------------------------------------------------------------
# mock      = heuristic clip selection (offline, no key required)
# anthropic = Claude-powered clip selection (requires AI_API_KEY)
CLIP_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="claude-opus-4-8"

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_PATH="./storage"

# ---------------------------------------------------------------------------
# Clip selection tuning (seconds)
# ---------------------------------------------------------------------------
# Short-form clips are kept in the 10–30s range.
CLIP_MIN_SECONDS="10"
CLIP_MAX_SECONDS="30"
MAX_CLIP_SUGGESTIONS="8"
